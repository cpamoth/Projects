{
  "name": "amoth-consulting-services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --coverage",
    "test:server": "vitest run tests/server",
    "verify": "npm run test:server && vitest run --coverage && npm run build && npm audit --omit=dev --audit-level=high && npm --prefix server audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.0",
    "pg": "^8.23.0",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^1.5.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
